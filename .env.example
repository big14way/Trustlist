# Chain access. Two providers, always. bloXroute serves archive eth_getLogs
# (max 5000 blocks, tested 17 Aug 2026). PublicNode covers near head reads.
BSC_RPC_HTTP=https://bsc.rpc.blxrbdn.com
BSC_RPC_HTTP_FALLBACK=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_HTTP=https://bsc-testnet-rpc.publicnode.com
CHAIN_ID=56

# Verified contract addresses, see docs/VERIFICATION.md
IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
AGENTIC_COMMERCE=0xea4daa3100a767e86fded867729ae7446476eba6

# Ours, filled in at deploy milestones. The rail may run on a different
# chain from the registries during development, so it carries its own rpc,
# chain id, kernel, and starting block.
HIRE_RAIL=
HIRE_RAIL_RPC=
HIRE_RAIL_CHAIN_ID=56
HIRE_RAIL_KERNEL=
HIRE_RAIL_DEPLOY_BLOCK=0
TRUST_SNAPSHOT=

DATABASE_URL=postgres://trustlist:trustlist@localhost:5432/trustlist

# SNAPSHOT_PUBLISHER_KEY joins this file at M6 with the publisher script.
# It is read only by deploy and publish scripts, never by api or web.

IPFS_GATEWAY=https://ipfs.io
IPFS_GATEWAY_FALLBACK=https://dweb.link
GRAPH_API_KEY=
PROBE_CONCURRENCY=64
PROBE_INTERVAL_SECS=1800
BSCSCAN_API_KEY=
API_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_CHAIN_ID joins this file at M3 with wallet connect.

# The snapshot register. Set to reuse an existing deployment; leave unset and
# scripts/PublishSnapshot.s.sol deploys a fresh one.
TRUST_SNAPSHOT=
# Where the web app reads the published root from. Must match TRUST_SNAPSHOT
# for the chain the app is pointed at.
NEXT_PUBLIC_TRUST_SNAPSHOT=
