# BSC mainnet, as deployed 31 August 2026. scripts/devchain.sh overwrites
# this file with dev chain values when you start a local chain, and the
# golden journeys need those, so the mainnet copy is kept beside it in
# web/.env.local.mainnet. Swap whichever one you need.
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_HIRE_RAIL=0x9fA9Cd8DDDd33eAc46C8c600371cc61ED79411e1
NEXT_PUBLIC_PAYMENT_TOKEN=0xcE24439F2D9C6a2289F741120FE202248B666666
# Deliberately empty until TrustSnapshot is deployed on mainnet. The dev
# chain register sat at 0x2685352E..., which is now TrustListHook's mainnet
# address, so a leftover value here would point the verify drawer at a hook.
NEXT_PUBLIC_TRUST_SNAPSHOT=
